	(text "COMPARATORS  -  LM339, open-collector, 5 V"
		(exclude_from_sim no)
		(at 21 173.5 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "303c8751-3806-5244-8634-1e7af90a529f")
	)
	(text "A  PRE_OK: switched bus / always-on bus > 90 %. A RATIO, so it holds from 21 V to 29.4 V. R12-R15 are 0.1 %;"
		(exclude_from_sim no)
		(at 21 349.0 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0accbdb4-b915-5ee2-85ec-c6f877828fac")
	)
	(text "   R16 is the hysteresis, and because it injects 5 V into a divider of a varying pack the threshold moves"
		(exclude_from_sim no)
		(at 21 352.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2249be6d-da37-526b-a216-71a0c5f5f75b")
	)
	(text "   88.3 .. 91.7 % over every corner -- below the 94.5 % the bus can reach through R1 with the ESCs idling."
		(exclude_from_sim no)
		(at 21 356.2 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ea4676dd-91be-5640-b989-a4fad457382b")
	)
	(text "B  FAULT timer: CHG charges C11 through R17; 1.7 s minimum against a 0.73 s worst precharge. D4 latches."
		(exclude_from_sim no)
		(at 21 359.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cf38eb28-f1a5-5663-9c8e-9dad5aa29ba2")
	)
	(text "C  ESTOP_OK: the far side of the E-stop loop is above 13.7 V.   D  ARM: host logic above 1.37 V (LVTTL)."
		(exclude_from_sim no)
		(at 21 363.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "3029c770-34f2-54ec-8a5d-7c804bdfb4f9")
	)
	(text "Every output node is pulled up to EN, not to 5 V, wherever it feeds the interlock: disarm and they all fall."
		(exclude_from_sim no)
		(at 21 367.0 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "5f141e7a-e44b-591d-a778-c2279e6e0dee")
	)
