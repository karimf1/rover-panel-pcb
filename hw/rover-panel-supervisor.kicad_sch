		(uuid "d76f8d50-3157-5f2a-a8b4-4566e10003ca")
	)
	(text "D1 stands off 30.8 V (a full 7S pack is 29.4 V) and clamps at 49.9 V, under the 60 V of every FET on the"
		(exclude_from_sim no)
		(at 131 154.0 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9e50b1a6-45ad-50bb-82db-7142c5ca8314")
	)
	(text "24 V side. It is unidirectional on purpose: a reversed supply forward-biases it and blows the panel's 2 A"
		(exclude_from_sim no)
		(at 131 157.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "d6181328-ed1c-5b35-8b02-94136bf66ec3")
	)
	(text "fuse at DIN2-203. D2 keeps a reversed pack off the buck in the meantime. R1/R2 hold the buck off below"
		(exclude_from_sim no)
		(at 131 161.2 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4685a50d-514e-51a0-9258-16d5f75b4074")
	)
	(text "12 V. R3 and R4 are 0R straps -- see spec.VERIFY: RT and ILIM to GND select PFM and the low current limit."
		(exclude_from_sim no)
		(at 131 164.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
