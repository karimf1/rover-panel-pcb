	(text "K1_G = EN, pulled low by Q2 while precharging and by Q3 on FAULT; C18 makes it rise 1 ms after CHG"
		(exclude_from_sim no)
		(at 306 389.0 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "595b27b1-3626-5844-94f9-6863b8ac03f2")
	)
	(text "falls, so a glitch cannot reach the coil. The coil current path is +24V -> P1.8 -> E-stop -> P1.3 ->"
		(exclude_from_sim no)
		(at 306 392.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f86966a4-429d-5cef-94b7-0c4b8ed652c2")
	)
	(text "P1.4 -> coil -> P1.6 -> Q1 -> GND: Q1 can only interrupt it. D5/D6 clamp both coil wires, which run"
		(exclude_from_sim no)
		(at 306 396.2 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "86d5538f-792c-5399-86fb-90549dbe510d")
	)
	(text "off the board. Q6 switches pack -> R1 -> switched bus; D7 clamps its gate to 12 V from 21 V to 29.4 V."
		(exclude_from_sim no)
		(at 306 399.8 0)
		(effects
