	(text "INTERLOCK LATCH  -  EN = armed by a fresh ARM edge while the E-stop loop is closed"
		(exclude_from_sim no)
		(at 306 173.5 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "90e95e49-9b0f-51a9-a5a8-fa0d1e377e1e")
	)
	(text "U4 makes CLR# = ARM AND ESTOP_OK, which clears U5 the instant either drops. U5 only SETS on a rising"
		(exclude_from_sim no)
		(at 306 284.0 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "aad3bcdc-ec89-57c1-b378-e59a64647f18")
	)
	(text "clock edge, and the clock is ARM delayed 10 ms by R28/C17 so CLR# is always released first. The"
		(exclude_from_sim no)
		(at 306 287.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b563490d-4743-504e-88e2-7ffd27211c5a")
	)
	(text "consequence is the one the rules ask for: releasing the E-stop does not re-energise K1 on its own --"
		(exclude_from_sim no)
		(at 306 291.2 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "adb31725-ff31-5ecf-bbef-c470135fa447")
	)
	(text "the host has to drop ARM and raise it again."
		(exclude_from_sim no)
		(at 306 294.8 0)
		(effects
